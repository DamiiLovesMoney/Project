local autoSendAcceptConnections = {}

local function StartAutoSendAccept()
    if autoSendAcceptConnections.megaSpamLoop then
        autoSendAcceptConnections.megaSpamLoop:Disconnect()
    end
    
    if autoSendAcceptConnections.acceptIncoming then
        autoSendAcceptConnections.acceptIncoming:Disconnect()
    end
    
    autoSendAcceptConnections.acceptIncoming = SendRequestGui.OnClientEvent:Connect(function(requester)
        if requester and requester ~= player then
            local acceptListStr = Get("AutoAcceptWhitelist", "")
            local blacklistStr = Get("AutoAcceptBlacklist", "")
            local acceptList = parseList(acceptListStr)
            local blacklist = parseList(blacklistStr)
            
            -- Check if player is blacklisted
            if isSafe(requester.Name, blacklist) or isSafe(requester.DisplayName, blacklist) then
                return
            end
            
            local shouldAccept = false
            if #acceptList == 0 then
                shouldAccept = true
            else
                if isTarget(requester.Name, acceptList) or isTarget(requester.DisplayName, acceptList) then
                    shouldAccept = true
                end
            end
            
            if shouldAccept then
                for i = 0, 1 do
                    pcall(function()
                        CarryRequest:FireServer(requester, 1, 0, 1, 0, 180, 0)
                    end)
                end
            end
        end
    end)
    
    autoSendAcceptConnections.megaSpamLoop = RunService.Heartbeat:Connect(function()
        if Get("AutoAcceptRequests", false) then
            local acceptListStr = Get("AutoAcceptWhitelist", "")
            local blacklistStr = Get("AutoAcceptBlacklist", "")
            local acceptList = parseList(acceptListStr)
            local blacklist = parseList(blacklistStr)
            
            for _, p in Players:GetPlayers() do
                if p ~= player then
                    -- Check if player is blacklisted
                    if isSafe(p.Name, blacklist) or isSafe(p.DisplayName, blacklist) then
                        continue
                    end
                    
                    local shouldSend = false
                    if #acceptList == 0 then
                        shouldSend = true
                    else
                        if isTarget(p.Name, acceptList) or isTarget(p.DisplayName, acceptList) then
                            shouldSend = true
                        end
                    end
                    
                    if shouldSend then
                        for i = 0, 1 do
                            pcall(function()
                                CarryRequest:FireServer(p, 1, 0, 1, 0, 180, 0)
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function StopAutoSendAccept()
    for k, v in pairs(autoSendAcceptConnections) do
        if v then v:Disconnect() end
    end
    autoSendAcceptConnections = {}
end

local function StartAutoDeclineRequests()
    if autoSendAcceptConnections.declineLoop then
        autoSendAcceptConnections.declineLoop:Disconnect()
    end
    
    autoSendAcceptConnections.declineLoop = RunService.Heartbeat:Connect(function()
        if Get("AutoDeclineRequests", false) then
            pcall(function()
                DeclineRequest:FireServer()
                StopCarry:FireServer()
            end)
        end
    end)
end

local function StopAutoDeclineRequests()
    if autoSendAcceptConnections.declineLoop then
        autoSendAcceptConnections.declineLoop:Disconnect()
        autoSendAcceptConnections.declineLoop = nil
    end
end


