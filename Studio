local function findPlayerByText(value)
	value = tostring(value or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
	if value == "" then return nil end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= me then
			if player.Name:lower() == value or player.DisplayName:lower() == value then
				return player
			end
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= me then
			if player.Name:lower():sub(1, #value) == value
				or player.DisplayName:lower():sub(1, #value) == value then
				return player
			end
		end
	end

	return nil
end

