--============================================================
-- ANTI RAGDOLL
--============================================================

local antiRagdollConnection

local function applyAntiRagdoll(character)
	if not antiRagdollEnabled then return end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
end

local function setAntiRagdoll(enabled)
	antiRagdollEnabled = enabled
	if antiRagdollConnection then
		antiRagdollConnection:Disconnect()
		antiRagdollConnection = nil
	end
	if enabled then
		if me.Character then applyAntiRagdoll(me.Character) end
		antiRagdollConnection = me.CharacterAdded:Connect(function(character)
			task.wait(0.25)
			applyAntiRagdoll(character)
		end)
	elseif me.Character then
		local humanoid = me.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
			humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		end
	end
end

--============================================================
-- HIT TP
--============================================================

local hitTPConnection
local hitTPBusy = false

local function setHitTP(enabled)
	hitTPEnabled = enabled
	if hitTPConnection then
		hitTPConnection:Disconnect()
		hitTPConnection = nil
	end
	if not enabled then return end

	local character = me.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local lastHealth = humanoid.Health
	hitTPConnection = humanoid.HealthChanged:Connect(function(newHealth)
		if not hitTPEnabled or hitTPBusy then
			lastHealth = newHealth
			return
		end

		if newHealth < lastHealth then
			local currentCharacter = me.Character
			local root = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
			if root then
				hitTPBusy = true
				local originalCFrame = root.CFrame
				root.CFrame = originalCFrame + Vector3.new(0, 30, 0)
				task.delay(0.5, function()
					local currentRoot = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
					if currentRoot and hitTPEnabled then currentRoot.CFrame = originalCFrame end
					hitTPBusy = false
				end)
			end
		end
		lastHealth = newHealth
	end)
end

