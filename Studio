-- FOLLOW
--============================================================

RunService.Heartbeat:Connect(function()
	if not followEnabled or not followTarget then
		return
	end

	local character = me.Character
	local targetCharacter = followTarget.Character

	if not character or not targetCharacter then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not targetRoot then
		return
	end

	local targetPosition =
		targetRoot.Position
		- targetRoot.CFrame.LookVector * followDistance

	root.CFrame =
		root.CFrame:Lerp(
			CFrame.lookAt(
				targetPosition,
				targetRoot.Position
			),
			math.clamp(followSpeed / 100, 0.01, 1)
		)
end)

--============================================================
-- RUSH
--============================================================

RunService.Heartbeat:Connect(function()
	if not rushEnabled or not rushTarget then
		return
	end

	local character = me.Character
	local targetCharacter = rushTarget.Character

	if not character or not targetCharacter then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not targetRoot then
		return
	end

	local direction =
		targetRoot.Position - root.Position

	if direction.Magnitude > 3 then
		local distance =
			math.min(
				rushSpeed / 10,
				direction.Magnitude
			)

		root.CFrame =
			CFrame.lookAt(
				root.Position + direction.Unit * distance,
				targetRoot.Position
			)
	end
end)

--============================================================
-- HITBOX AURA
--============================================================

local function resetHitbox(player)
	if not player or not player.Character then
		return
	end

	local root =
		player.Character:FindFirstChild("HumanoidRootPart")

	if root then
		pcall(function()
			root.Size = Vector3.new(2, 2, 1)
			root.Transparency = 1
			root.Material = Enum.Material.Plastic
			root.CanCollide = true
			root.Shape = Enum.PartType.Block
		end)
	end
end

RunService.Heartbeat:Connect(function()
	if not hitboxAuraEnabled then
		return
	end

	local character = me.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")

	if not myRoot then
		return
	end

	local nearest
	local shortest = math.huge
	local active = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= me and player.Character then
			local root =
				player.Character:FindFirstChild("HumanoidRootPart")

			if root then
				local distance =
					(myRoot.Position - root.Position).Magnitude

				if distance < shortest then
					shortest = distance
					nearest = player
				end
			end
		end
	end

	if nearest and shortest <= hitboxDistance then
		local root =
			nearest.Character
			and nearest.Character:FindFirstChild("HumanoidRootPart")

		if root then
			active[nearest] = true
			modifiedHitboxes[nearest] = true

			pcall(function()
				root.Size =
					Vector3.new(
						hitboxSize,
						hitboxSize,
						hitboxSize
					)

				root.Transparency = 0.95
				root.Color = Color3.fromRGB(255, 182, 193)
				root.Material = Enum.Material.Neon
				root.CanCollide = false
				root.Shape = Enum.PartType.Ball
			end)
		end
	end

	for player in pairs(modifiedHitboxes) do
		if not active[player] then
			resetHitbox(player)
			modifiedHitboxes[player] = nil
		end
	end
end)

--============================================================
-- ANTI GRAB
--============================================================

local function _arc_resetState()
end

local function setupAntiGrab(character)
	local humanoid =
		character:WaitForChild("Humanoid", 10)

	local root =
		character:WaitForChild("HumanoidRootPart", 10)

	if not humanoid or not root then
		return
	end

	humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
		if not antiGrabEnabled then
			return
		end

		if humanoid.PlatformStand then
			local originalPosition = root.Position

			_arc_resetState()

			local folder =
				ReplicatedStorage:FindFirstChild("EventInviteSystem")

			if folder then
				local event =
					folder:FindFirstChild("EventTeleportEvent")

				if event then
					pcall(function()
						event:FireServer()
					end)
				end
			end

			task.delay(antiGrabDelay, function()
				local currentCharacter = me.Character

				local currentRoot =
					currentCharacter
					and currentCharacter:FindFirstChild("HumanoidRootPart")

				if currentRoot then
					currentRoot.CFrame =
						CFrame.new(originalPosition)
				end

				_arc_resetState()
			end)
		end
	end)
end

