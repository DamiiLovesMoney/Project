local function makeAuraLight(root, brightness, range)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(245, 250, 255)
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = root
	addEffectObject(light)
end

local function makeBeamRay(root, angle, length, width, height)
	local ray = Instance.new("Part")
	ray.Anchored = false
	ray.CanCollide = false
	ray.CanTouch = false
	ray.CanQuery = false
	ray.Massless = true
	ray.Material = Enum.Material.Neon
	ray.Color = Color3.fromRGB(245, 250, 255)
	ray.Transparency = 0.12
	ray.Size = Vector3.new(width, height, length)
	ray.CFrame = root.CFrame
		* CFrame.new(0, 1.5, 0)
		* CFrame.Angles(0, angle, math.rad(-8))
	ray.Parent = root.Parent

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = ray
	weld.Parent = ray

	addEffectObject(ray)

	return ray
end

local function makeAuraRing(root, radius, height, speed, offset)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.12, radius * 2, radius * 2)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(240, 250, 255)
	ring.Transparency = 0.2
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.Massless = true
	ring.Parent = root.Parent

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = ring
	weld.Parent = ring

	addEffectObject(ring)

	local connection
	connection = RunService.Heartbeat:Connect(function()
		if not ring.Parent or not root.Parent then
			connection:Disconnect()
			return
		end

		local t = tick() * speed + offset
		ring.CFrame = root.CFrame
			* CFrame.new(0, height, 0)
			* CFrame.Angles(math.rad(90), t, math.sin(t * 0.7) * 0.35)
	end)
	table.insert(effectConnections, connection)
end

local function updateEffects()
	clearEffects()

	local character = me.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	local head = character:FindFirstChild("Head")
	if not root then return end

	local active = false

	-- All V2 effects now use the bright GOD-AURA visual style.
	-- They differ mainly by their energy pattern/color while keeping the
	-- old effect buttons compatible with the rest of the menu.
	local auraColor = Color3.fromRGB(245, 250, 255)
	local secondaryColor = Color3.fromRGB(185, 205, 255)

	if effects.King or effects.Inferno or effects.Void or effects.Lightning
		or effects.Crystal or effects.Energy or effects.Meteor
		or effects.DarkMoon or effects.Galaxy or effects.Reaper then
		active = true
	end

	if not active then return end

	-- Huge glowing core around the character.
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(7.5, 7.5, 7.5)
	core.Material = Enum.Material.Neon
	core.Color = auraColor
	core.Transparency = 0.88
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.Massless = true
	core.Parent = character

	local coreWeld = Instance.new("WeldConstraint")
	coreWeld.Part0 = root
	coreWeld.Part1 = core
	coreWeld.Parent = core
	addEffectObject(core)

	makeAuraLight(root, 8, 24)
	if head then
		makeAuraLight(head, 5, 16)
	end

	-- Dense white energy cloud.
	createParticles(
		root,
		auraColor,
		120,
		NumberRange.new(2, 8),
		NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.05),
			NumberSequenceKeypoint.new(0.5, 0.18),
			NumberSequenceKeypoint.new(1, 0.02)
		})
	)

	-- Bright secondary sparks.
	createParticles(
		root,
		secondaryColor,
		70,
		NumberRange.new(3, 11),
		NumberSequence.new(0.08)
	)

	-- Multiple rotating energy rings.
	makeAuraRing(root, 3.5, -1.8, 2.5, 0)
	makeAuraRing(root, 5.0, 0.0, -1.8, 1.5)
	makeAuraRing(root, 6.5, 2.0, 1.2, 3)
	makeAuraRing(root, 8.0, 0.5, -0.8, 5)

	-- Radial god-energy rays.
	for i = 1, 18 do
		local angle = math.pi * 2 / 18 * i
		local ray = makeBeamRay(root, angle, math.random(8, 14), 0.12, math.random(1, 3) / 10)

		local connection
		connection = RunService.Heartbeat:Connect(function()
			if not ray.Parent then
				connection:Disconnect()
				return
			end

			local pulse = 0.65 + math.sin(tick() * 4 + i) * 0.25
			ray.Transparency = math.clamp(pulse, 0.25, 0.9)
		end)
		table.insert(effectConnections, connection)
	end

	-- Floating energy sparks around the body.
	for i = 1, 24 do
		local angle = math.pi * 2 / 24 * i
		local orb = createOrb(
			root,
			auraColor,
			Vector3.new(math.cos(angle) * 5, math.sin(angle * 2) * 3 + 1.5, math.sin(angle) * 5),
			math.random(12, 28) / 100
		)

		local connection
		connection = RunService.Heartbeat:Connect(function()
			if not orb.Parent then
				connection:Disconnect()
				return
			end

			local t = tick() * 2 + i
			orb.CFrame = root.CFrame * CFrame.new(
				math.cos(t) * 5,
				math.sin(t * 1.4) * 3 + 1.5,
				math.sin(t) * 5
			)
		end)
		table.insert(effectConnections, connection)
	end

	-- Extra crown/head energy burst.
	if head then
		for i = 1, 10 do
			local angle = math.pi * 2 / 10 * i
			local spark = createOrb(
				head,
				auraColor,
				Vector3.new(math.cos(angle) * 2.2, 1.5 + math.sin(angle) * 0.5, math.sin(angle) * 2.2),
				0.18
			)
			local connection
			connection = RunService.Heartbeat:Connect(function()
				if not spark.Parent then
					connection:Disconnect()
					return
				end
				local t = tick() * 2.5 + i
				spark.CFrame = head.CFrame * CFrame.new(
					math.cos(t) * 2.2,
					1.5 + math.sin(t * 2) * 0.5,
					math.sin(t) * 2.2
				)
			end)
			table.insert(effectConnections, connection)
		end
	end
end

