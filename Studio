--============================================================
-- EFFECT CLEANUP
--============================================================

local function clearEffects()
	for _, connection in ipairs(effectConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(effectConnections)

	for _, object in ipairs(effectObjects) do
		pcall(function()
			object:Destroy()
		end)
	end

	table.clear(effectObjects)
end

local function addEffectObject(object)
	table.insert(effectObjects, object)
	return object
end

--============================================================
-- EFFECT HELPERS
--============================================================

local function createAttachment(root)
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	addEffectObject(attachment)
	return attachment
end

local function createParticles(root, color, rate, speed, size)
	local attachment = createAttachment(root)

	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = rate or 30
	emitter.Speed = speed or NumberRange.new(2, 5)
	emitter.Lifetime = NumberRange.new(0.8, 1.8)
	emitter.SpreadAngle = Vector2.new(360, 360)
	emitter.LightEmission = 1
	emitter.Size = size or NumberSequence.new(0.35)
	emitter.Color = ColorSequence.new(color)
	emitter.Parent = attachment

	addEffectObject(emitter)
end

local function createRing(root, color, size)
	local ring = Instance.new("Part")
	ring.Name = "DamiiEffectRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.15, size, size)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.25
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.Massless = true
	ring.Anchored = false
	ring.CFrame = root.CFrame * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = root.Parent

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = ring
	weld.Parent = ring

	addEffectObject(ring)

	return ring
end

local function createOrb(root, color, offset, size)
	local orb = Instance.new("Part")
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(size, size, size)
	orb.Material = Enum.Material.Neon
	orb.Color = color
	orb.CanCollide = false
	orb.CanTouch = false
	orb.CanQuery = false
	orb.Massless = true
	orb.CFrame = root.CFrame * CFrame.new(offset)
	orb.Parent = root.Parent

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = orb
	weld.Parent = orb

	addEffectObject(orb)

	return orb
end

