--============================================================
-- SPECIAL FOLLOW LOOP
--============================================================

RunService.Heartbeat:Connect(function()
	if not specialFollowEnabled or not specialFollowTarget then
		return
	end

	local character = me.Character
	local targetCharacter = specialFollowTarget.Character

	if not character or not targetCharacter then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not targetRoot then
		return
	end

	if specialFollowMode == "Piggyback" then
		-- Elevated directly behind the target, same direction.
		local desired =
			targetRoot.CFrame
			* CFrame.new(0, 1.25, 0.75)

		root.CFrame = root.CFrame:Lerp(
			desired,
			math.clamp(specialFollowSpeed / 100, 0.12, 0.65)
		)

	elseif specialFollowMode == "Crack" then
		-- Always stays BEHIND the target.
		-- Moves forward toward the target and backward away from it.
		local wave = (math.sin(tick() * 3.2) + 1) / 2
		local nearDistance = 1.15
		local farDistance = 4.25
		local distance = farDistance + (nearDistance - farDistance) * wave

		local desired =
			targetRoot.CFrame
			* CFrame.new(0, specialFollowHeight, distance)

		root.CFrame = root.CFrame:Lerp(
			desired,
			math.clamp(specialFollowSpeed / 100, 0.08, 0.5)
		)
	end
end)

--============================================================
-- TP WALK
--============================================================

RunService.Heartbeat:Connect(function()
	if not tpWalkEnabled then
		return
	end

	local character = me.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if humanoid and root and humanoid.MoveDirection.Magnitude > 0 then
		root.CFrame =
			root.CFrame
			+ humanoid.MoveDirection * tpWalkSpeed
	end
end)

--============================================================
-- ORBIT
--============================================================

RunService.Heartbeat:Connect(function()
	if not orbitEnabled or not orbitTarget then
		return
	end

	local character = me.Character
	local targetCharacter = orbitTarget.Character

	if not character or not targetCharacter then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

	if not root or not targetRoot then
		return
	end

	local angle = tick() * orbitSpeed

	local offset = Vector3.new(
		math.cos(angle) * orbitDistance,
		0,
		math.sin(angle) * orbitDistance
	)

	root.CFrame =
		CFrame.new(targetRoot.Position + offset)
end)

